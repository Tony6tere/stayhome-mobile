# Fins de ligne normalisées en LF dans le dépôt : évite que chaque machine
# (Windows / macOS / CI) ne réécrive des fichiers entiers dans les diffs.
* text=auto eol=lf

# Binaires : jamais de conversion, jamais de diff textuel.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.hbc binary

# Fichier généré : réduit le bruit dans les revues de code.
package-lock.json linguist-generated=true
